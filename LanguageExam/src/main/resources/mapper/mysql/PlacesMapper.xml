<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org/DTD Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="language.exam.repository.PlacesMapper">
	<resultMap type="language.exam.domain.exams.model.Places" id="places">
		<id column="id" property="id"></id>
		<result column="place" property="place"></result>
	</resultMap>
	<select id="selectAllPlaces" resultMap="places">
		select * from places 
	</select>
	
	<select id="selectPlace" resultMap="places">
		select * from places 
		where id = #{id} 
	</select>
</mapper>