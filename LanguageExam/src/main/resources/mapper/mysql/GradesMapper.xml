<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org/DTD Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="language.exam.repository.GradesMapper">
	<resultMap type="language.exam.domain.exams.model.Grades" id="grades">
		<id column="g_id" property="id"></id>
		<result column="grade" property="grade"></result>
		<association property="fees" resultMap="language.exam.repository.FeesMapper.fees"></association>
		<collection property="placeList" ofType="language.exam.domain.exam.Places" resultMap="language.exam.repository.PlacesMapper.places"></collection>
	</resultMap>
	<select id="selectAllGrades" resultType="Grades">
		select * from grades 
	</select>
	
	<select id="selectGrade" resultType="Grades">
		select * from grades 
		where id = #{id} 
	</select>
	
	<select id="countGrades" resultType="int">
		select count(*) from grades 
		where id = #{gradeId} 
	</select>
	
	<select id="selectIds" resultType="Integer">
		select id from grades 
	</select>
	
	<select id="selectExamDates" resultMap="grades">
		select
		 grades.id as g_id, grades.grade,
		 places.id as p_id, places.place, ei.id as e_id,
		 ei.exam_date, subject_id
		from grades
		join places
		left outer join (
		 select * from exam_infos where subject_id = #{subjectId} 
		) ei
		 on grades.id = grade_id and places.id = place_id
		order by p_id asc, g_id asc
	</select>
</mapper>