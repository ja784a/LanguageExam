<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org/DTD Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="language.exam.repository.SubjectsMapper">
	<resultMap type="language.exam.domain.exams.model.Subjects" id="subjects">
		<id column="s_id" property="id"></id>
		<result column="subject" property="subject"></result>
		<collection property="gradeList" ofType="language.exam.domain.exam.model.Grades" resultMap="language.exam.repository.GradesMapper.grades"></collection>
	</resultMap>
	<select id="selectAllSubjects" resultType="Subjects">
		select * from subjects 
	</select>
	
	<select id="selectSubject" resultType="Subjects">
		select * from subjects 
		where id = #{id} 
	</select>
	
	<select id="countSubjects" resultType="int">
		select count(*) from subjects 
		where id = #{subjectId} 
	</select>
	
	<select id="selectFees" resultMap="subjects">
		select subjects.id as s_id, subjects.subject, grades.id as g_id, grades.grade, fees.id as f_id, fees.fee from subjects 
		join grades 
		right join fees 
		on grades.id = grade_id 
		and subjects.id = subject_id 
		order by subjects.id asc, grades.id asc 
	</select>
</mapper>